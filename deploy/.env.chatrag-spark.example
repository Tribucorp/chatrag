# Copiar a deploy/.env.chatrag-spark y rellenar con valores reales antes de:
#   docker compose --env-file deploy/.env.chatrag-spark -f deploy/docker-compose.chatrag-spark.yml up -d
# Nunca versionar deploy/.env.chatrag-spark (ver .gitignore) — contiene secretos reales.

# Imágenes NIM — mismo pin exacto y ya validado en GB10 que
# tribu-sdk/deploy/.env.maestro.example (misma cuenta NGC, mismo hardware). NIM_CHAT_IMAGE
# reutiliza el chat NIM del maestro (nemotron-nano-9b) — no hay un NIM de chat "propio" de
# ChatRAG todavía, y este ya está confirmado funcionando en este mismo modelo de Spark.
NIM_CHAT_IMAGE=nvcr.io/nim/nvidia/nvidia-nemotron-nano-9b-v2-dgx-spark:1.0.0-variant
NIM_EMBED_IMAGE=nvcr.io/nim/nvidia/llama-nemotron-embed-1b-v2:1
NIM_RERANK_IMAGE=nvcr.io/nim/nvidia/llama-nemotron-rerank-vl-1b-v2:2.3

# API key de NGC (docker login nvcr.io) — la misma cuenta de Tribucorp que usa el maestro
# (tribu-sdk/deploy/.env.maestro), reutilizada aquí con confirmación explícita de Javier
# (16-sep-2026): no hay motivo para pensar que está limitada a un solo Spark.
NGC_API_KEY=changeme

# Credenciales del stack Milvus incluido (ver ../tribu-sdk/python/tribu-rag/deploy/.env.example)
# — necesarias aquí también porque docker compose resuelve ${VAR} de TODOS los servicios
# (incluidos vía `include:`) contra este mismo --env-file. Generar valores reales.
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme

# Bearer compartido entre el frontend (BFF) y chatrag-api — el navegador nunca lo ve. Generar:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CHATRAG_SERVICE_BEARER_TOKEN=changeme
# Bearer del panel /admin — secreto DISTINTO al de arriba (dos callers de confianza distintos).
CHATRAG_ADMIN_TOKEN=changeme
# Secreto de Auth.js v5 (src/lib/auth.ts) — generar: openssl rand -base64 32
CHATRAG_AUTH_SECRET=changeme
# URL pública real donde queda el frontend — ver CHATRAG_FRONTEND_BIND_HOST más abajo, debe
# coincidir con esa IP/puerto (Auth.js valida el origin contra esto).
CHATRAG_AUTH_URL=http://127.0.0.1:3000

# Sin tribu-auth ni proveedor SSO real todavía (ver CLAUDE.md), /query responde 401 a
# cualquier visitante real salvo que esto esté puesto — su propio docstring dice "NUNCA
# activar en producción". Déjalo vacío si este despliegue es para que el equipo lo pruebe
# igual que produccion (sin identidad real, todo 401 salvo /admin); ponlo solo si es un
# ambiente de prueba consciente de esa concesión.
# CHATRAG_DEV_IDENTITY_BYPASS=dev-spark

# Nombre visible de la app (tema por defecto, editable después desde /admin/theme).
CHATRAG_APP_NAME=ChatRAG

# Opcional — por defecto los NIM, chatrag-api y el frontend solo escuchan en 127.0.0.1 del
# propio Spark (acceso solo vía SSH). Para que el equipo llegue al chat real desde su propia
# máquina por la tailnet, fija estos a la IP Tailscale real del Spark (`tailscale ip -4`,
# ejecutado EN el Spark) — nunca "0.0.0.0", eso expondría el servicio en cualquier interfaz de
# red del Spark, no solo la tailnet. Requiere recrear el contenedor para aplicarse.
# NIM_CHAT_BIND_HOST=100.x.x.x
# CHATRAG_API_BIND_HOST=100.x.x.x
# CHATRAG_FRONTEND_BIND_HOST=100.x.x.x

# model_id real del NIM de chat, tal como lo reporta /v1/models tras el primer arranque —
# deploy/despliegue_spark.sh lo consulta solo y sustituye esto; no hace falta rellenarlo a
# mano salvo que el script no pueda (ver su fase 5).
# CHATRAG_NIM_CHAT_MODEL=nemotron
