# Paquetes TS del Tribu SDK: GitHub Packages, privado de la organización (ADR-0020 del SDK,
# docs/CONSUMIR_EL_SDK.md). NODE_AUTH_TOKEN: en local un token con read:packages
# (`export NODE_AUTH_TOKEN=$(gh auth token)`); en CI, el GITHUB_TOKEN del workflow.
@tribucorp:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
