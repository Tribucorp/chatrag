# --- Frontend (Next.js) ---
# URL del backend RAG del SDK (chatrag-api). En dev, el servicio local.
NEXT_PUBLIC_CHATRAG_API_URL=http://localhost:8080
# Voz: apagada. tribu-voice bloqueado por revisión legal NVIDIA (Riva stock, sin clonación).
NEXT_PUBLIC_VOICE_ENABLED=0

# App
NEXT_PUBLIC_APP_NAME=ChatRAG · Comuna de Santiago

