# --- Frontend (Next.js) — BFF en src/app/api/chat/route.ts ---
# URL del backend RAG del SDK (chatrag-api), SERVER-ONLY (sin NEXT_PUBLIC_: el navegador ya no
# habla directo con el backend, solo con /api/chat). En dev, el servicio local.
CHATRAG_API_URL=http://localhost:8080
# Mismo valor que CHATRAG_SERVICE_BEARER_TOKEN del backend (ver más abajo) — el BFF es el único
# caller autorizado a declarar identidad ante el backend. Sin configurar, el BFF no manda
# Authorization y el backend confía en X-User-Id/X-User-Acls sin más (comportamiento actual).
# CHATRAG_SERVICE_BEARER_TOKEN=
#
# Scaffold de Auth.js v5 (src/lib/auth.ts) — deriva la sesión real que puebla X-User-Id/
# X-User-Acls hacia el backend. Sin `providers` configurado (TODO en auth.ts, pendiente de
# proveedor SSO/OIDC del ecosistema Tribucorp) nadie puede autenticarse todavía: el chat opera
# en modo abstención salvo que actives CHATRAG_DEV_IDENTITY_BYPASS en el backend para dev local.
CHATRAG_AUTH_SECRET=
# Voz: apagada por defecto, opt-in explícito. tribu-voice integrado (revisión legal NVIDIA
# confirmada, ver CLAUDE.md) — Riva stock, jamás clonación, jamás inferir la emoción del
# usuario desde su audio. Contrato de red con el NIM Riva real sin verificar (ver
# backend/src/chatrag_api/voice.py) — confirmar antes de encender en producción.
NEXT_PUBLIC_VOICE_ENABLED=0

# App
NEXT_PUBLIC_APP_NAME=ChatRAG · Comuna de Santiago

# --- Backend (chatrag-api) — ver backend/.env; NIM on-prem, nada de APIs cloud ---
# CHATRAG_NIM_EMBED_URL=http://localhost:8002
# CHATRAG_NIM_RERANK_URL=http://localhost:8003
# CHATRAG_NIM_CHAT_URL=http://localhost:8004
# model_id tal como lo reporta CADA NIM en /v1/models — el de embed está verificado contra el
# Spark real (tribu-sdk/scripts/ingesta_corpus.py); el de rerank sigue la convención de nombre
# de imagen pero sin verificar todavía contra un NIM real, confirmar antes de producción.
# CHATRAG_NIM_EMBED_MODEL_ID=nvidia/llama-nemotron-embed-1b-v2
# CHATRAG_NIM_RERANK_MODEL_ID=nvidia/llama-nemotron-rerank-vl-1b-v2
# Nombre del modelo tal como lo expone ese NIM (/v1/chat/completions) — varía por despliegue.
# CHATRAG_NIM_CHAT_MODEL=nemotron
# CHATRAG_EMBED_DIM=2048
# CHATRAG_VOICE_ENABLED=0
# NIM Riva TTS/ASR (ver voice.py) — contrato de red sin verificar contra un NIM Riva real,
# solo se usan si CHATRAG_VOICE_ENABLED=1.
# CHATRAG_NIM_TTS_URL=http://localhost:8005
# CHATRAG_NIM_ASR_URL=http://localhost:8006
# Milvus real (tribu_rag.milvus_store.MilvusVectorStore) — ver
# tribu-sdk/python/tribu-rag/deploy/docker-compose.milvus.yml para levantarlo. Colección física
# por tenant (aislamiento real, no un filtro de metadato) — fijo por despliegue.
# CHATRAG_MILVUS_URI=http://localhost:19530
# CHATRAG_TENANT_ID=chatrag-santiago
# Directorio con el corpus Markdown que ingiere `POST /admin/reindex` — relativo al directorio
# de trabajo del proceso (`cd backend && uv run uvicorn ...`, ver README).
# CHATRAG_KNOWLEDGE_DIR=../knowledge
# Bearer del panel /admin (ingesta, reindex, estado del índice, audit trail) — mismo mecanismo
# que CHATRAG_SERVICE_BEARER_TOKEN pero un secreto propio, nunca el mismo valor: son dos
# callers de confianza distintos. Sin configurar, /admin/* responde 503 (nunca abierto por
# defecto, ni siquiera en dev).
# CHATRAG_ADMIN_TOKEN=
# Identidad de desarrollo mientras Auth.js no tenga un provider real (ver CHATRAG_AUTH_SECRET
# arriba): el BFF no manda X-User-Id sin sesión. Fail-closed si se omite. NUNCA activar en
# producción.
# CHATRAG_DEV_IDENTITY_BYPASS=dev-local
# Exige Authorization: Bearer <token> (mismo valor que CHATRAG_SERVICE_BEARER_TOKEN del
# frontend, arriba) antes de confiar en X-User-Id/X-User-Acls — el BFF (src/app/api/chat/
# route.ts) ya existe, así que actívalo en cuanto despliegues ambos lados juntos. Sin
# configurar, cualquier caller que alcance el backend puede declarar su propia identidad.
# CHATRAG_SERVICE_BEARER_TOKEN=
# Traza de decisión sobre tribu-audit (ver backend/src/chatrag_api/audit.py) — Postgres
# respalda la cadena WORM HMAC. Ambas opt-in: sin ellas, NullAuditLog (sin traza, la consulta
# sigue funcionando). CHATRAG_AUDIT_CHAIN_KEY es la clave HMAC de la cadena, hex-encoded —
# generar con `python -c "import secrets; print(secrets.token_hex(32))"`, nunca reutilizar
# entre entornos.
# CHATRAG_AUDIT_DATABASE_URL=postgresql://usuario:password@localhost:5432/chatrag_audit
# CHATRAG_AUDIT_CHAIN_KEY=
# Theming (Fase B, backend/src/chatrag_api/theme.py) — editable desde /admin/theme. Con
# CHATRAG_AUDIT_DATABASE_URL configurada, el tema vive en esa misma Postgres (tabla
# chatrag_theme); si no, en este fichero JSON (creado al primer guardado, gitignored). Incluye
# voice_id (catálogo stock de tribu_voice, ver voice.py) y app_name como marca de la voz.
# CHATRAG_THEME_FILE=../theme.json
# Robustez (backend/src/chatrag_api/middleware.py): límite de tasa en memoria por IP sobre
# /query y /voice/* — no apto para múltiples réplicas (cada proceso cuenta por su cuenta).
# <=0 desactiva el límite (útil en tests/dev).
# CHATRAG_RATE_LIMIT_MAX_REQUESTS=30
# CHATRAG_RATE_LIMIT_WINDOW_SECONDS=60
# Timeout de la llamada completa retriever+generador en /query — 504 si se supera (NIM caído).
# CHATRAG_QUERY_TIMEOUT_SECONDS=30
# Buffer en memoria de conversaciones recientes + métricas de consumo del RAG (ver
# backend/src/chatrag_api/conversations.py), consumido por /admin/conversations y
# /admin/metrics. Siempre activo, sin configuración dura — esto solo ajusta cuántas
# conversaciones recientes caben en el buffer circular (los contadores acumulados no se capan).
# CHATRAG_CONVERSATION_LOG_MAX_ENTRIES=200
