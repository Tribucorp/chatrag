# --- Frontend (Next.js) ---
# Voz: apagada. tribu-voice bloqueado por revisión legal NVIDIA (Riva stock, sin clonación).
NEXT_PUBLIC_VOICE_ENABLED=0

# App
NEXT_PUBLIC_APP_NAME=ChatRAG · Comuna de Santiago

# --- Auth (tribu-auth / better-auth, servidor Next.js — nunca en el navegador) ---
# Secreto de firma de sesión/cookies. Generar con `openssl rand -base64 32`. Sin default:
# el servidor falla al arrancar si falta (ver src/lib/auth.ts).
CHATRAG_AUTH_SECRET=
# URL pública donde corre este frontend (sirve auth.handler en /api/auth/*).
CHATRAG_AUTH_URL=http://localhost:3000
# URL del backend RAG del SDK (chatrag-api), server-only: la llama el BFF (/api/chat), NUNCA
# el navegador — reemplaza al antiguo NEXT_PUBLIC_CHATRAG_API_URL (deprecado, eliminado).
CHATRAG_API_URL=http://localhost:8080

# --- Backend (chatrag-api) — ver backend/.env; NIM on-prem, nada de APIs cloud ---
# CHATRAG_NIM_EMBED_URL=http://localhost:8002
# CHATRAG_NIM_RERANK_URL=http://localhost:8003
# CHATRAG_NIM_CHAT_URL=http://localhost:8004
# Nombre del modelo tal como lo expone ese NIM (/v1/chat/completions) — varía por despliegue.
# CHATRAG_NIM_CHAT_MODEL=nemotron
# CHATRAG_EMBED_DIM=2048
# CHATRAG_VOICE_ENABLED=0
# Identidad de desarrollo mientras tribu-auth no esté wireado al cliente (el chat no manda
# X-User-Id). Fail-closed si se omite. NUNCA activar en producción.
# CHATRAG_DEV_IDENTITY_BYPASS=dev-local
